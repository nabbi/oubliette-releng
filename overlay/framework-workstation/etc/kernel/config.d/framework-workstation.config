# Framework Workstation (AMD Ryzen AI Max+ PRO 495, Strix Halo family:
# Radeon 8060S iGPU, XDNA NPU, RTL8126 5GbE, MediaTek MT7925 "RZ717" Wi-Fi),
# stage4 only. Merged by gentoo-kernel on top of the Gentoo dist config
# (/etc/kernel/config.d). Vendor guidance: kernel >= 7.3
# (https://frame.work/desktop?tab=linux).
# Headless LLM host: no display, sound, touch or laptop options.

# Console on the GOP framebuffer until amdgpu takes over
CONFIG_DRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM_SIMPLEDRM=y
# The dist default "qr_code" needs a Rust-enabled kernel
CONFIG_DRM_PANIC_SCREEN="kmsg"

# iGPU (gfx1151): amdgpu for Vulkan (RADV) and, through KFD, ROCm/HIP.
# HSA_AMD_SVM + HMM_MIRROR + DEVICE_PRIVATE give ROCm shared virtual memory,
# which the unified LPDDR5X pool needs.
CONFIG_DRM_AMDGPU=m
CONFIG_DRM_AMDGPU_USERPTR=y
CONFIG_DRM_AMD_DC=y
CONFIG_HSA_AMD=y
CONFIG_HSA_AMD_SVM=y
CONFIG_HMM_MIRROR=y
CONFIG_ZONE_DEVICE=y
CONFIG_DEVICE_PRIVATE=y
CONFIG_MMU_NOTIFIER=y

# XDNA NPU
CONFIG_DRM_ACCEL=y
CONFIG_DRM_ACCEL_AMDXDNA=m

# Platform: IOMMU, frequency scaling, idle, sensors, TPM
CONFIG_AMD_IOMMU=y
CONFIG_X86_AMD_PSTATE=y
CONFIG_AMD_PMC=m
CONFIG_SENSORS_K10TEMP=m
CONFIG_EDAC_AMD64=m
# fTPM (CRB); built in so the initramfs has it without modules
CONFIG_TCG_CRB=y
CONFIG_TCG_TIS=y

# RTL8126 5GbE
CONFIG_R8169=m
CONFIG_REALTEK_PHY=m

# MediaTek MT7925 (RZ717) Wi-Fi 7 and Bluetooth (USB)
CONFIG_MT7925E=m
CONFIG_MT7925U=m
CONFIG_BT_MTK=m
CONFIG_BT_HCIBTUSB_MTK=y

# USB4 on the two USB-C ports
CONFIG_USB4=m
