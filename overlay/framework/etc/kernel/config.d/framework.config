# Framework 13 Pro (Intel Core Ultra Series 3 / Panther Lake), stage4 only.
# Merged by gentoo-kernel on top of the Gentoo dist config (/etc/kernel/config.d).
# Vendor guidance: kernel >= 6.19,
# 7.0+ recommended (https://frame.work/laptop13pro?tab=linux).

# Early console on the GOP framebuffer until xe takes over
CONFIG_DRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM_SIMPLEDRM=y
# The dist default "qr_code" needs a Rust-enabled kernel; without one it warns
# at boot and falls back to "user"
CONFIG_DRM_PANIC_SCREEN="kmsg"

# Arc B390 / Xe3 iGPU (xe only; i915 does not drive Panther Lake)
CONFIG_DRM_XE=m
CONFIG_DRM_XE_DISPLAY=y
# GSC proxy / PXP / HDCP over MEI, used by xe for HuC auth and protected content
CONFIG_INTEL_MEI=m
CONFIG_INTEL_MEI_ME=m
CONFIG_INTEL_MEI_GSC_PROXY=m
CONFIG_INTEL_MEI_PXP=m
CONFIG_INTEL_MEI_HDCP=m

# NPU
CONFIG_DRM_ACCEL=y
CONFIG_DRM_ACCEL_IVPU=m

# Platform: GPIO (touchpad/touchscreen IRQs), idle, thermal, power
CONFIG_PINCTRL_INTEL_PLATFORM=y
CONFIG_INTEL_IDLE=y
CONFIG_INT340X_THERMAL=m
CONFIG_INTEL_PMC_CORE=m
CONFIG_INTEL_TPMI=m
CONFIG_INTEL_HID_EVENT=m
CONFIG_INTEL_VBTN=m
CONFIG_POWERCAP=y
CONFIG_INTEL_RAPL=m

# Thunderbolt 4 / USB4 with DMA protection
CONFIG_USB4=m
CONFIG_INTEL_IOMMU=y
CONFIG_INTEL_IOMMU_DEFAULT_ON=y
# Firmware hands over in x2APIC mode; without IR the kernel panics before
# any console is up
CONFIG_IRQ_REMAP=y
# TDX host support (dist default): a laptop hosts no TDX guests, and the
# platform has none ("virt/tdx: TDX not supported by the host platform")
# CONFIG_INTEL_TDX_HOST is not set
CONFIG_TYPEC_UCSI=m
CONFIG_UCSI_ACPI=m

# Intel BE211: Wi-Fi 7 (iwlmld) and Bluetooth (PCIe on Panther Lake, 0xE476)
CONFIG_IWLWIFI=m
CONFIG_IWLMVM=m
CONFIG_IWLMLD=m
CONFIG_BT=m
CONFIG_BT_HCIBTUSB=m
CONFIG_BT_INTEL=m
CONFIG_BT_INTEL_PCIE=m

# Haptic touchpad and in-cell touchscreen (I2C-HID or Intel THC)
CONFIG_HID_MULTITOUCH=m
CONFIG_HID_HAPTIC=y
CONFIG_I2C_HID_ACPI=m
CONFIG_INTEL_THC_HID=m
CONFIG_INTEL_QUICKI2C=m
CONFIG_INTEL_QUICKSPI=m

# Sensor hub (ambient light / lid sensors)
CONFIG_IIO=m
CONFIG_INTEL_ISH_HID=m
CONFIG_HID_SENSOR_HUB=m
CONFIG_HID_SENSOR_ALS=m

# Audio: SOF on Panther Lake. The 13 Pro's analog codec is a Realtek ALC285 on
# the HDA link (internal mic through the codec), so SOF needs the HDA generic
# machine driver; SoundWire stays for other PTL boards' codecs.
CONFIG_SND_SOC_SOF_TOPLEVEL=y
CONFIG_SND_SOC_SOF_INTEL_TOPLEVEL=y
CONFIG_SND_SOC_SOF_PANTHERLAKE=m
CONFIG_SND_SOC_SOF_HDA_LINK=y
CONFIG_SND_SOC_SOF_HDA_AUDIO_CODEC=y
CONFIG_SND_HDA_CODEC_HDMI=m
CONFIG_SND_HDA_CODEC_ALC269=m
CONFIG_SND_SOC_INTEL_SKL_HDA_DSP_GENERIC_MACH=m
CONFIG_SND_SOC_INTEL_USER_FRIENDLY_LONG_NAMES=y
CONFIG_SPI=y
CONFIG_SPI_MASTER=y
CONFIG_SND_SOC_SOF_INTEL_SOUNDWIRE=m
CONFIG_SND_SOC_INTEL_SOUNDWIRE_SOF_MACH=m
CONFIG_SOUNDWIRE=m
CONFIG_SOUNDWIRE_INTEL=m

# Webcam
CONFIG_MEDIA_SUPPORT=m
CONFIG_MEDIA_USB_SUPPORT=y
CONFIG_MEDIA_CAMERA_SUPPORT=y
CONFIG_USB_VIDEO_CLASS=m

# Framework EC (CrOS EC over LPC): charge limits, LEDs, Type-C, sensors
CONFIG_CHROME_PLATFORMS=y
CONFIG_CROS_EC=m
CONFIG_CROS_EC_LPC=m
CONFIG_CROS_EC_CHARDEV=m
CONFIG_CROS_EC_SYSFS=m
CONFIG_CROS_KBD_LED_BACKLIGHT=m
CONFIG_CROS_EC_TYPEC=m
CONFIG_CROS_TYPEC_SWITCH=m
CONFIG_CHARGER_CROS_CONTROL=m

# Sleep: s2idle for lid close (the cloud baseline has no suspend at all),
# hibernate when a swap device is set up
CONFIG_SUSPEND=y
CONFIG_HIBERNATION=y

# intel_pstate turns the default governor into its policy: performance would
# pin EPP 0 on every core. powersave still ramps under load.
CONFIG_CPU_FREQ_DEFAULT_GOV_POWERSAVE=y

# Thermal and frequency helpers for the hybrid P/E/LPE cores (thermald, HFI)
CONFIG_INTEL_HFI_THERMAL=y
CONFIG_INTEL_TCC_COOLING=m
CONFIG_INTEL_POWERCLAMP=m
CONFIG_INTEL_TURBO_MAX_3=y
CONFIG_INTEL_UNCORE_FREQ_CONTROL=m

# Temperatures: per-core and NVMe (NVME_HWMON needs HWMON built in)
CONFIG_HWMON=y
CONFIG_SENSORS_CORETEMP=m
CONFIG_NVME_HWMON=y
# spd5118 (DDR5 DIMM temperature, dist default) binds on the SMBus and fails
# on every resume (error -6)
# CONFIG_SENSORS_SPD5118 is not set

# EC power/charge LEDs under /sys/class/leds
CONFIG_LEDS_CLASS_MULTICOLOR=m
CONFIG_LEDS_CROS_EC=m

# Storage expansion cards and USB-C SSDs
CONFIG_USB_UAS=m

# Bluetooth LE keyboards/mice (HoG) and AVRCP media keys
CONFIG_UHID=m
CONFIG_INPUT_UINPUT=m

# Type-C alternate modes in sysfs (muxing itself is done by firmware via UCSI)
CONFIG_TYPEC_DP_ALTMODE=m
CONFIG_TYPEC_TBT_ALTMODE=m

# Codec runtime power saving
CONFIG_SND_HDA_POWER_SAVE_DEFAULT=1

# fwupd: read-only Intel SPI flash checks of the BIOS region
CONFIG_MTD=m
CONFIG_MTD_SPI_NOR=m
CONFIG_SPI_INTEL_PCI=m

# zram swap (zram-init) with zstd
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y

# nftables host firewall (/etc/nftables.rules)
CONFIG_NF_TABLES=m
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NFT_CT=m
CONFIG_NFT_LOG=m
CONFIG_NFT_LIMIT=m
CONFIG_NFT_REJECT=m
CONFIG_NFT_REJECT_INET=m

# Yama ptrace scope (already in CONFIG_LSM, but not built)
CONFIG_SECURITY_YAMA=y
