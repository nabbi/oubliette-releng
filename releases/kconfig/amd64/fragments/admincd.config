# admincd: generic hardware compatibility, merged on top of the cloud baseline.
# Nothing machine-specific belongs here; Framework-only options live in
# framework.config and land only in the stage4.

# Console on any UEFI GOP framebuffer (new iGPUs the kernel can't drive yet).
# No native GPU drivers: the ISO's pruned linux-firmware has no GPU blobs, and
# i915/xe/amdgpu evict the firmware framebuffer before failing on missing
# firmware, which leaves a blank screen.
CONFIG_DRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM_SIMPLEDRM=y

# Newer Intel laptop platforms
CONFIG_PINCTRL_INTEL_PLATFORM=y
CONFIG_PINCTRL_METEORLAKE=y
CONFIG_VMD=y
CONFIG_INTEL_IDLE=y

# Wi-Fi 7 (BE2xx) uses the iwlmld op mode
CONFIG_IWLMLD=m

# Thunderbolt / USB4 docks and storage
CONFIG_USB4=m
