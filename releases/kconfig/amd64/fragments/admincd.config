# admincd: generic hardware compatibility, merged on top of the cloud baseline.
# Nothing machine-specific belongs here; Framework-only options live in
# framework.config and land only in the stage4.

# Console on any UEFI GOP framebuffer (new iGPUs the kernel can't drive yet).
# No native GPU drivers: the ISO's pruned linux-firmware has no GPU blobs, and
# i915/xe/amdgpu evict the firmware framebuffer before failing on missing
# firmware, which leaves a blank screen.
CONFIG_DRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM_SIMPLEDRM=y

# Newer Intel laptop platforms
CONFIG_PINCTRL_INTEL_PLATFORM=y
CONFIG_PINCTRL_METEORLAKE=y
CONFIG_VMD=y
CONFIG_INTEL_IDLE=y

# Interrupt remapping. Recent Intel firmware hands over in x2APIC mode, and
# without IR the kernel panics trying to drop back to xAPIC, before any
# console is up.
CONFIG_IOMMU_SUPPORT=y
CONFIG_INTEL_IOMMU=y
CONFIG_AMD_IOMMU=y
CONFIG_IRQ_REMAP=y

# I2C HID touchpads; without it they fall back to basic PS/2 emulation
CONFIG_I2C_HID=m
CONFIG_I2C_HID_ACPI=m
CONFIG_HID_MULTITOUCH=m

# Wi-Fi 7 (BE2xx) uses the iwlmld op mode
CONFIG_IWLMLD=m

# Thunderbolt / USB4 docks and storage
CONFIG_USB4=m

# Common Wi-Fi 6E/7 cards beyond Intel: MediaTek MT7925, Realtek RTL8922AE
# and RTL8852BTE, plus RTL8814A
CONFIG_MT7925E=m
CONFIG_MT7925U=m
CONFIG_RTW89_8922AE=m
CONFIG_RTW89_8852BTE=m
CONFIG_RTW88_8814AE=m
CONFIG_RTW88_8814AU=m

# The livecd boots with overlayfs over the squashfs; built in so the root
# mount doesn't depend on the initramfs module list
CONFIG_OVERLAY_FS=y
