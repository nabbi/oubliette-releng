# Strix Halo iGPU: the kernel's amdgpu driver, Mesa's radeonsi (GL) and radv
# (Vulkan). The arch/amd64 default also builds intel nouveau radeon vesa.
*/* VIDEO_CARDS: -* amdgpu radeonsi

# vulkan: radv, the Vulkan driver llama.cpp/ollama run on
media-libs/mesa vulkan

# Headless: mesa defaults to +X, which needs libglvnd[X] and the X11 libs.
# radv needs neither.
media-libs/mesa -X
