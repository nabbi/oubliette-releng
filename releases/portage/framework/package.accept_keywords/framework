# framework_tool / framework-tool-tui: not yet stabilized, needed for
# battery charge limits, fan control, LEDs, and firmware version info on
# Framework hardware.
app-laptop/framework_tool ~amd64
app-laptop/framework-tool-tui ~amd64

# brightnessctl: only ~amd64 in the oubliette overlay; backlight control.
app-misc/brightnessctl ~amd64

# 9999 live ebuilds from the oubliette overlay
x11-misc/alock **
games-roguelike/evilhack **
x11-wm/fluxbox **
app-portage/genup **

# gentoo-kernel 7.2: Framework 13 Pro (Panther Lake) needs >= 6.19, 7.0+
# recommended; stable is 6.18. Fragment: overlay/framework/etc/kernel/config.d/framework.config
=sys-kernel/gentoo-kernel-7.2* ~amd64
=virtual/dist-kernel-7.2* ~amd64

# igt-gpu-tools: intel_gpu_top for the Xe3 iGPU, ~amd64 only
x11-apps/igt-gpu-tools ~amd64

# linux-firmware 20260810: iwlwifi-sc-a0-wh-b0-c106 (kernel 7.2's max API;
# stable 20260622 stops at c103) and xe ptl GuC 70.72.1. Pinned: 20260910 and
# 20260916 break the BE211 Bluetooth DDC load (Intel_Write_DDC -22), fixed in
# 20261019. Regenerate the savedconfig with each bump.
=sys-kernel/linux-firmware-20260810 ~amd64
